# =============================================================================
# Kwami LiveKit API - Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in your credentials:
#   cp .env.sample .env
#
# =============================================================================

# =============================================================================
# App Configuration
# =============================================================================
APP_ENV=development
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8080

# CORS (comma-separated origins, use * for development)
CORS_ORIGINS=http://localhost:5173,https://kwami.io

# Enable OpenAPI docs at /docs and /redoc in production (default: false)
# ENABLE_DOCS=true

# =============================================================================
# LiveKit Configuration (required for token generation)
# =============================================================================
# Get these from https://cloud.livekit.io/projects/YOUR_PROJECT/settings/keys

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# LiveKit SIP / telephony
# Platform model:
#   The SIP trunks below are shared infrastructure for the whole app.
#   End users can still buy/attach their own numbers in kwami-app, and the API
#   maps those numbers to specific kwamis, then syncs them onto the shared
#   calling infrastructure automatically.
#   You should not need to pre-register one manual number per kwami here.
#
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID:
#   Shared LiveKit outbound SIP trunk ID used for programmatic outbound calls.
#   User-created numbers are synced onto this shared trunk automatically.
# LIVEKIT_SIP_INBOUND_TRUNK_ID:
#   Optional shared LiveKit inbound SIP trunk ID. Only set this if you want the
#   API to keep the inbound trunk's explicit number allowlist in sync too.
#   If omitted, inbound routing can still work via the shared Twilio voice
#   webhook + LIVEKIT_SIP_INBOUND_URI flow.
# LIVEKIT_SIP_INBOUND_URI:
#   LiveKit SIP URI that Twilio dials for inbound calls, e.g.
#   sip:your-project.sip.livekit.cloud;transport=tcp
# LIVEKIT_SIP_DIAL_TRANSPORT:
#   Transport used when bridging calls into LiveKit SIP.
# LIVEKIT_SIP_PARTICIPANT_ATTRIBUTE_KEY:
#   Attribute key used to pass kwami identity through SIP participants.

LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_INBOUND_URI=
LIVEKIT_SIP_DIAL_TRANSPORT=tcp
LIVEKIT_SIP_PARTICIPANT_ATTRIBUTE_KEY=kwami_id

# Public API base URL used to build Twilio webhook endpoints.
# Example: https://api.kwami.io
APP_PUBLIC_URL=

# =============================================================================
# Twilio (required for phone number search/purchase and WhatsApp)
# =============================================================================
# Get these from https://console.twilio.com/
#
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN:
#   Core platform Twilio API credentials used to provision user-owned numbers.
# TWILIO_PHONE_COUNTRY:
#   Default country used when searching or normalizing numbers.
# TWILIO_SIP_TRUNK_SID:
#   Shared Twilio SIP trunk that purchased user numbers are attached to.
# TWILIO_WHATSAPP_FROM:
#   Optional default WhatsApp sender in the form whatsapp:+14155550123
# TWILIO_VOICE_STATUS_CALLBACK_URL / TWILIO_MESSAGING_STATUS_CALLBACK_URL:
#   Optional explicit callback URLs. Leave blank to derive from APP_PUBLIC_URL.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_COUNTRY=US
TWILIO_SIP_TRUNK_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_STATUS_CALLBACK_URL=
TWILIO_MESSAGING_STATUS_CALLBACK_URL=

# =============================================================================
# SendGrid (email Smart Hub)
# =============================================================================
# SENDGRID_API_KEY: Mail Send API key from https://app.sendgrid.com/settings/api_keys
# SENDGRID_INBOUND_WEBHOOK_SECRET: shared secret for inbound parse verification.
#   REQUIRED whenever SENDGRID_API_KEY is set -- production refuses to boot without
#   it, and /webhooks/email/inbound refuses every delivery. It was "optional" while
#   an unset secret made the endpoint skip the check, which left it publicly writable.
# EMAIL_DOMAIN: domain for user email addresses (default: kwami.io)

SENDGRID_API_KEY=
SENDGRID_INBOUND_WEBHOOK_SECRET=
EMAIL_DOMAIN=kwami.io

# =============================================================================
# Zep Cloud (required for memory endpoints)
# =============================================================================
# Get your API key:
#   1. Create account at https://app.getzep.com/
#   2. Go to Project Settings > API Keys
#   3. Create a new API key

ZEP_API_KEY=z_your-zep-api-key

# =============================================================================
# Supabase
# =============================================================================
# Get these from Supabase Dashboard: Project Settings > API Keys
#
# SUPABASE_URL: Project URL - used for JWKS auth token verification
# SUPABASE_SECRET_KEY: Secret API key (sb_secret_...) - admin DB access

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-supabase-secret-key

# =============================================================================
# Stripe (required for credit purchases)
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
# Webhook secret from https://dashboard.stripe.com/webhooks

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# =============================================================================
# Wallet / Solana
# =============================================================================
# WALLET_CUSTODY_PROVIDER:
#   - mock (default): deterministic mock wallet keys for local dev/test
#   - your managed custody provider name for production
WALLET_NETWORK=mainnet-beta
# In development/staging, wallet defaults to enabled when omitted.
# In production, set explicitly to true to activate.
WALLET_ENABLED=true
WALLET_CUSTODY_PROVIDER=mock
WALLET_CUSTODY_SIGNING_SECRET=
WALLET_WEBHOOK_SECRET=
WALLET_CARD_PROVIDER_BASE_URL=https://buy-provider.example.com

# =============================================================================
# Kwami API Key (shared secret between agent and API)
# =============================================================================
# Used by the agent to report usage (X-API-Key header). Generate a random string.

KWAMI_API_KEY=your-random-kwami-api-key

# =============================================================================
# Admin access
# =============================================================================
# Two independent ways to reach /admin/reconciliation, both optional and both
# off when unset. ADMIN_EMAILS is checked against the verified Supabase JWT;
# ADMIN_API_KEY is a shared secret for callers that have no user session.
#
# ADMIN_EMAILS: comma-separated, matched case-insensitively.
# ADMIN_API_KEY: generate a random string. Unset means the key route is closed.

ADMIN_EMAILS=
ADMIN_API_KEY=

# =============================================================================
# Token lifetime
# =============================================================================
# How long an issued LiveKit token stays valid. Tokens are redeemed at connect
# time, so they do not need a long life; 15 minutes is the default and a leaked
# token expires with it. Raise only if a client caches tokens across a session.
# Bounds: 1..360.

# LIVEKIT_TOKEN_TTL_MINUTES=15

# The `agentName` put on the dispatch rule for a room.
# LIVEKIT_AGENT_NAME=kwami-agent

# =============================================================================
# Credits safety
# =============================================================================
# What happens when the balance check itself errors (database down, timeout).
#
#   true  — let the session start anyway, and settle later.
#   false — refuse the session.
#
# Defaults to true OUTSIDE production and false IN production: an outage should
# not hand out unbilled sessions on the deployment that bills. Set it explicitly
# to override either default.

# CREDITS_FAIL_OPEN_ON_CHECK_ERROR=false

# =============================================================================
# Billing policy
# =============================================================================
# What a session costs the user, on top of what it costs us. Every value has a
# working default; override only to change pricing.
#
# BILLING_PRICING_VERSION: stamped on each settled transaction, so a price
#   change is auditable after the fact. Bump it when any number below changes.
# BILLING_MARKUP_MULTIPLIER: provider cost x this = user cost.
# BILLING_FIXED_FEE_USD: added per session, after the markup.
# BILLING_FALLBACK_COST_PER_1M_TOKENS_USD: used when a model has no entry in
#   the pricing table — a wrong-but-charged is better than a free unknown model.

# BILLING_PRICING_VERSION=2026-03-20
# BILLING_MARKUP_MULTIPLIER=2.0
# BILLING_FIXED_FEE_USD=0.0
# BILLING_FALLBACK_COST_PER_1M_TOKENS_USD=2.0

# Per-call costs for the tools an agent can invoke. All default to 0.0, which
# means "not billed" — set them to the provider's real per-call price to bill.

# BILLING_TAVILY_SEARCH_PER_CALL_USD=0.0
# BILLING_TAVILY_EXTRACT_PER_CALL_USD=0.0
# BILLING_SERPAPI_SEARCH_PER_CALL_USD=0.0
# BILLING_MICROLINK_FETCH_PER_CALL_USD=0.0
# BILLING_ZEP_ADD_MESSAGES_PER_CALL_USD=0.0
# BILLING_ZEP_GET_CONTEXT_PER_CALL_USD=0.0
# BILLING_ZEP_SEARCH_PER_CALL_USD=0.0
# BILLING_ZEP_GET_USER_NAME_PER_CALL_USD=0.0
# BILLING_ZEP_CREATE_USER_PER_CALL_USD=0.0
# BILLING_ZEP_CREATE_THREAD_PER_CALL_USD=0.0

# =============================================================================
# Provider reconciliation (/admin/reconciliation)
# =============================================================================
# Read-only credentials for pulling each provider's own usage and diffing it
# against what we billed. Unset means that provider is skipped in the report,
# not that the report fails.

# OPENAI_ADMIN_KEY: an Admin key (not a project key) — the usage API needs it.
# OPENAI_ADMIN_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# TAVILY_API_KEY=
# TAVILY_PROJECT_ID=
# RECONCILIATION_TAVILY_COST_PER_CREDIT_USD=0.008

# LIVEKIT_CLOUD_PROJECT_ID=
# LIVEKIT_ANALYTICS_TOKEN=
# LIVEKIT_CLOUD_API_BASE=https://cloud-api.livekit.io/api
# RECONCILIATION_LIVEKIT_CONNECTION_MINUTE_USD=0.0
# RECONCILIATION_LIVEKIT_BANDWIDTH_GB_USD=0.0

# ZEP_API_BASE=https://api.getzep.com/api/v2
# ZEP_USAGE_API_URL=

# =============================================================================
# Platform and test overrides
# =============================================================================
# PORT: set by Fly.io and Heroku; takes precedence over API_PORT when present.
#   Do not set it by hand — it exists so the platform can pick the port.
#
# KWAMI_ENV_FILE: which env file Settings reads. The test suite points it at
#   tests/.env.test so a test that reaches an unmocked path cannot talk to
#   production. Leave it unset outside the test suite.
