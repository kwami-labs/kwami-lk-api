{
  "tagFormat": "v${version}",
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "feat", "release": "minor" },
          { "type": "*", "release": "patch" }
        ]
      }
    ],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# kwami-lk-api — Changelog\n\nAll notable changes to this service are documented here. This file is generated from the commit history by semantic-release — do not edit it by hand.\n\nThe service is 1.x: `feat!` or a `BREAKING CHANGE:` footer bumps the major, `feat` the minor, and every other conventional type a patch. `v0.1.0` and `v0.1.1` are the pre-1.0 line; everything before `v0.1.0` lives in the git log rather than here."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./scripts/set-version.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "README.md", "pyproject.toml", "uv.lock", "src/__init__.py"],
        "message": "chore(release): v${nextRelease.version} [skip actions]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "releasedLabels": false,
        "failTitle": "The automated release is failing 🚨"
      }
    ]
  ]
}
