# This package is only the Wrangler toolchain. A global 24h minimumReleaseAge
# rejected wrangler@4.133.0 on first install, so the CLI never landed and
# nothing was deployed. Exclude the Cloudflare toolchain from that gate.
minimum-release-age-exclude[]=wrangler
minimum-release-age-exclude[]=miniflare
minimum-release-age-exclude[]=workerd
minimum-release-age-exclude[]=@cloudflare/workerd-linux-64
minimum-release-age-exclude[]=@cloudflare/unenv-preset
