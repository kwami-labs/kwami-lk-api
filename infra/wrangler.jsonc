{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker that terminates TLS and proxies into the FastAPI container.
  // The Python app cannot run on the Workers isolate (native wheels,
  // uvicorn, livekit-agents). Cloudflare Containers run the existing
  // Dockerfile; this Worker is the public entrypoint.
  //
  // Terraform (infra/terraform) owns zone/DNS/custom-domain attachment.
  // Do not add `routes` / `custom_domain` here — that would fight Terraform.
  "name": "kwami-lk-api",
  "main": "src/index.ts",
  // Admin@nexow.ai's Account — the same one that hosts kwami-app.
  "account_id": "132a7551ad4a90e979a18f7c4cfd364e",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "APP_ENV": "development",
    "API_HOST": "0.0.0.0",
    "API_PORT": "8080",
    "DEBUG": "false",
    "ENABLE_DOCS": "false",
    "CONTAINER_INSTANCES": "2",
    "APP_PUBLIC_URL": "https://kwami-lk-api.nexow.workers.dev",
    "CORS_ORIGINS": "https://kwami.io,https://kwami-app.nexow.workers.dev"
  },
  "containers": [
    {
      "class_name": "KwamiApiContainer",
      // Build context is the repo root (parent of this config).
      "image": "../Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KWAMI_API",
        "class_name": "KwamiApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KwamiApiContainer"]
    }
  ],
  "env": {
    "development": {
      "name": "kwami-lk-api-dev",
      "durable_objects": {
        "bindings": [
          {
            "name": "KWAMI_API",
            "class_name": "KwamiApiContainer"
          }
        ]
      },
      "vars": {
        "APP_ENV": "development",
        "API_HOST": "0.0.0.0",
        "API_PORT": "8080",
        "DEBUG": "false",
        "ENABLE_DOCS": "true",
        "CONTAINER_INSTANCES": "1",
        "APP_PUBLIC_URL": "https://kwami-lk-api-dev.nexow.workers.dev",
        "CORS_ORIGINS": "https://kwami-app-dev.nexow.workers.dev,http://localhost:5173"
      },
      "containers": [
        {
          "class_name": "KwamiApiContainer",
          "image": "../Dockerfile",
          "instance_type": "basic",
          "max_instances": 1
        }
      ]
    },
    "staging": {
      "name": "kwami-lk-api-stg",
      "durable_objects": {
        "bindings": [
          {
            "name": "KWAMI_API",
            "class_name": "KwamiApiContainer"
          }
        ]
      },
      "vars": {
        "APP_ENV": "staging",
        "API_HOST": "0.0.0.0",
        "API_PORT": "8080",
        "DEBUG": "false",
        "ENABLE_DOCS": "false",
        "CONTAINER_INSTANCES": "2",
        "APP_PUBLIC_URL": "https://kwami-lk-api-stg.nexow.workers.dev",
        "CORS_ORIGINS": "https://kwami-app-stg.nexow.workers.dev"
      },
      "containers": [
        {
          "class_name": "KwamiApiContainer",
          "image": "../Dockerfile",
          "instance_type": "basic",
          "max_instances": 2
        }
      ]
    },
    "production": {
      "name": "kwami-lk-api",
      "durable_objects": {
        "bindings": [
          {
            "name": "KWAMI_API",
            "class_name": "KwamiApiContainer"
          }
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "API_HOST": "0.0.0.0",
        "API_PORT": "8080",
        "DEBUG": "false",
        "ENABLE_DOCS": "false",
        "CONTAINER_INSTANCES": "3",
        "APP_PUBLIC_URL": "https://kwami-lk-api.nexow.workers.dev",
        "CORS_ORIGINS": "https://kwami.io,https://kwami-app.nexow.workers.dev"
      },
      "containers": [
        {
          "class_name": "KwamiApiContainer",
          "image": "../Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 3
        }
      ]
    }
  }
}
