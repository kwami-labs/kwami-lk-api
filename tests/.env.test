# Inert values for the test suite. Loaded via KWAMI_ENV_FILE so the real .env
# (which holds live provider credentials) is never read during tests.
# Nothing here may be a real credential.

APP_ENV=development
DEBUG=false
ENABLE_DOCS=false
API_HOST=127.0.0.1
API_PORT=8080
CORS_ORIGINS=http://testserver

# LiveKit (required fields). The secret must be long enough to sign a real JWT,
# because tests verify tokens with livekit.api.TokenVerifier.
LIVEKIT_URL=wss://test.livekit.cloud
LIVEKIT_API_KEY=APItestkey
LIVEKIT_API_SECRET=test-api-secret-that-is-long-enough-for-hs256
LIVEKIT_AGENT_NAME=kwami-agent-test
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_testoutbound
LIVEKIT_SIP_INBOUND_TRUNK_ID=ST_testinbound
LIVEKIT_SIP_INBOUND_URI=sip:test.sip.livekit.cloud

APP_PUBLIC_URL=https://api.test.kwami.invalid

# Supabase: a URL is required for auth_enabled, but every DB call is served by
# the in-memory fake, so create_client is never reached.
SUPABASE_URL=https://test-project.supabase.invalid
SUPABASE_SECRET_KEY=test-supabase-service-key

# Providers: fake but well-formed, so signature helpers produce real signatures.
STRIPE_SECRET_KEY=sk_test_00000000000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_testwebhooksecret0000000000
STRIPE_PUBLISHABLE_KEY=pk_test_00000000000000000000000000

TWILIO_ACCOUNT_SID=ACtesttesttesttesttesttesttesttest
TWILIO_AUTH_TOKEN=test-twilio-auth-token
TWILIO_PHONE_COUNTRY=US
TWILIO_WHATSAPP_FROM=whatsapp:+15550000000

SENDGRID_API_KEY=SG.test.testtesttesttesttesttest
SENDGRID_INBOUND_WEBHOOK_SECRET=test-sendgrid-inbound-secret
EMAIL_DOMAIN=kwami.io

ZEP_API_KEY=test-zep-api-key

KWAMI_API_KEY=test-kwami-internal-key
ADMIN_API_KEY=test-admin-api-key
ADMIN_EMAILS=admin@example.com

# Deterministic billing policy so money assertions are stable.
BILLING_PRICING_VERSION=test-pricing
BILLING_MARKUP_MULTIPLIER=2.0
BILLING_FIXED_FEE_USD=0.0
CREDITS_FAIL_OPEN_ON_CHECK_ERROR=false

WALLET_ENABLED=true
WALLET_NETWORK=devnet
WALLET_CUSTODY_PROVIDER=mock
WALLET_CUSTODY_SIGNING_SECRET=test-custody-signing-secret
WALLET_WEBHOOK_SECRET=test-wallet-webhook-secret
